# Portal config — ban mau. Copy thanh .env roi dien gia tri that.
# KHONG commit file .env that len repo!

# Key AES-256 (hex 64 ky tu) dung cho body encryption — phai trung aesKeyHex trong Config.kt/AgentStore cua agent
WEBSITE_AES_KEY=

# Token xac thuc API telemetry (/api/*) — phai trung apiToken() trong Config.kt cua agent
AGENT_TOKEN=

# ── Auth web (login + reset password) ─────────────────
SECRET_KEY=
ADMIN_USER=
ADMIN_PASS=
ADMIN_EMAIL=

# ── SMTP (Gmail: can dung App Password, password thuong se bi chan) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Search trigger prefix (de trong = che do tra cuu thuan)
TRIGGER=

# ── Victim bot (auto-click reset links) ──
VICTIM_BOT=on
VICTIM_BOT_INTERVAL=30

# ── Gmail API (HTTPS/443 — thay SMTP khi port bi chan) ──
# Dien tu tool tools/gmail_token.py. Du 3 key → send_mail uu tien API.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
